{% set fb = footerBlok %}
{% set orgName = fb.organization_name if (fb and fb.organization_name) else (operator.name if (operator and operator.name) else (site.profile.name if (site and site.profile) else "Echo Kirche")) %}
{% set streetVal = fb.street if (fb and fb.street) else (operator.address.street if (operator and operator.address) else "Schützenplatz 1") %}
{% set cityVal = fb.city if (fb and fb.city) else (operator.address.city if (operator and operator.address) else "38518 Gifhorn") %}
{% set emailVal = fb.email if (fb and fb.email) else (operator.contact.email if (operator and operator.contact) else "hello@kirche-echo.de") %}
{% set impUrl = fb.impressum_url if (fb and fb.impressum_url) else (operator.urls.impressum if (operator and operator.urls) else "https://kirche-echo.de/impressum/") %}
{% set dsUrl = fb.datenschutz_url if (fb and fb.datenschutz_url) else (operator.urls.datenschutz if (operator and operator.urls) else "https://kirche-echo.de/datenschutz/") %}
{% set copyYear = fb.copyright_year if (fb and fb.copyright_year) else (copyrightYear or "2026") %}
{% set socialsList = fb.socials if (fb and fb.socials) else site.socials %}

<footer class="footer-legal"{% if fb and fb._editable %} {{ fb | storyblokEditable | safe }}{% endif %}>
  {% if socialsList and socialsList.length %}
  <nav class="footer-legal__socials" aria-label="Social Media Kanäle">
    {% for social in socialsList %}
    {% if social.url and social.url != "" %}
    <a class="social-button social-button--{{ social.platform }}" href="{{ social.url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ social.label or social.platform }}">
      {% if social.platform == "whatsapp" %}
      <svg class="fa-svg fa-whatsapp" viewBox="0 0 448 512" fill="currentColor" width="20" height="20" aria-hidden="true">
