<details class="dropdown-card"{% if item._editable %} {{ item | storyblokEditable | safe }}{% endif %}>
  <summary class="dropdown-card__summary link-button{% if item.icon and item.icon != '' %} link-button--with-icon{% endif %}">
    {% if item.icon and item.icon != '' %}
    <span class="link-button__icon" aria-hidden="true">
      {% if item.icon == "church" or item.icon == "fa-church" %}
      <svg class="fa-svg fa-church" viewBox="0 0 576 512" fill="currentColor" width="18" height="18"><path d="M576 448c0 35.3-28.7 64-64 64H64c-35.3 0-64-28.7-64-64s28.7-64 64-64v-64c0-35.3 28.7-64 64-64h48v-32c0-17.7 14.3-32 32-32h16V64h-16c-8.8 0-16-7.2-16-16s7.2-16 16-16h16V16c0-8.8 7.2-16 16-16s16 7.2 16 16v16h16c8.8 0 16 7.2 16 16s-7.2 16-16 16h-16v128h16c17.7 0 32 14.3 32 32v32h48c35.3 0 64 28.7 64 64v64c35.3 0 64 28.7 64 64zM240 352v96h96v-96c0-26.5-21.5-48-48-48s-48 21.5-48 48z"/></svg>
      {% elif item.icon == "calendar" or item.icon == "fa-calendar" or item.icon == "events" %}
      <svg class="fa-svg fa-calendar" viewBox="0 0 448 512" fill="currentColor" width="18" height="18"><path d="M128 0c17.7 0 32 14.3 32 32V64H288V32c0-17.7 14.3-32 32-32s32 14.3 32 32V64h48c26.5 0 48 21.5 48 48v48H0V112C0 85.5 21.5 64 48 64H96V32c0-17.7 14.3-32 32-32zM0 192H448V464c0 26.5-21.5 48-48 48H48c-26.5 0-48-21.5-48-48V192zm64 80c-8.8 0-16 7.2-16 16v48c0 8.8 7.2 16 16 16h48c8.8 0 16-7.2 16-16V288c0-8.8-7.2-16-16-16H64zm128 0c-8.8 0-16 7.2-16 16v48c0 8.8 7.2 16 16 16h48c8.8 0 16-7.2 16-16V288c0-8.8-7.2-16-16-16H192zm144 0c-8.8 0-16 7.2-16 16v48c0 8.8 7.2 16 16 16h48c8.8 0 16-7.2 16-16V288c0-8.8-7.2-16-16-16H336z"/></svg>
      {% else %}
      <svg class="fa-svg fa-church" viewBox="0 0 576 512" fill="currentColor" width="18" height="18"><path d="M576 448c0 35.3-28.7 64-64 64H64c-35.3 0-64-28.7-64-64s28.7-64 64-64v-64c0-35.3 28.7-64 64-64h48v-32c0-17.7 14.3-32 32-32h16V64h-16c-8.8 0-16-7.2-16-16s7.2-16 16-16h16V16c0-8.8 7.2-16 16-16s16 7.2 16 16v16h16c8.8 0 16 7.2 16 16s-7.2 16-16 16h-16v128h16c17.7 0 32 14.3 32 32v32h48c35.3 0 64 28.7 64 64v64c35.3 0 64 28.7 64 64zM240 352v96h96v-96c0-26.5-21.5-48-48-48s-48 21.5-48 48z"/></svg>
      {% endif %}
    </span>
    {% endif %}
    <span class="link-button__label">{{ item.label }}</span>
    <span class="dropdown-card__chevron" aria-hidden="true">
      <svg class="fa-svg fa-chevron-down" viewBox="0 0 448 512" fill="currentColor" width="14" height="14"><path d="M201.4 342.6c12.5 12.5 32.8 12.5 45.3 0l160-160c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L224 274.7 86.6 137.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3l160 160z"/></svg>
    </span>
  </summary>
  <div class="dropdown-card__content">
    {% if item.description %}
    <p class="dropdown-card__description">{{ item.description }}</p>
    {% endif %}

    {% set rawItemsList = item.columns if (item.columns and item.columns.length > 0) else item.times %}
    {% set itemsList = rawItemsList | filterBySurface(surface) if surface else rawItemsList %}
    {% set isColumns = (item.layout == "columns") or (not item.layout and itemsList and itemsList.length > 0) %}

    {% if itemsList and itemsList.length > 0 %}
      {% if isColumns %}
      <ul class="dropdown-card__columns" role="list">
        {% for col in itemsList %}
        <li class="dropdown-card__column"{% if col.showOn or col.show_on %} data-show-on="{{ (col.showOn or col.show_on) | join(',') }}"{% endif %}{% if col.displayInDefault !== undefined %} data-display-in-default="{{ col.displayInDefault }}"{% elif col.display_in_default !== undefined %} data-display-in-default="{{ col.display_in_default }}"{% endif %}>
          <div class="dropdown-card__column-header">
            <strong class="dropdown-card__column-title">{{ col.title }}</strong>
            {% if col.location %}
            <span class="dropdown-card__column-location">{{ col.location }}</span>
            {% endif %}
          </div>
          <div class="dropdown-card__column-badges">
            <span class="dropdown-card__column-badge">{{ col.time }}</span>
            {% if col.hasKids or col.has_kids or col.kids %}
            <span class="dropdown-card__kids-badge" aria-label="{{ col.kidsLabel or col.kids_label or 'Echo Kids verfügbar' }}">
              <svg class="fa-svg fa-child" viewBox="0 0 384 512" fill="currentColor" width="12" height="12" aria-hidden="true"><path d="M192 0c44.2 0 80 35.8 80 80s-35.8 80-80 80-80-35.8-80-80 35.8-80 80-80zM57.7 203.3c7.8-10.7 22.8-13.1 33.5-5.3L192 271l100.8-73c10.7-7.8 25.7-5.4 33.5 5.3s5.4 25.7-5.3 33.5L216 312v152c0 13.3-10.7 24-24 24s-24-10.7-24-24V312L63 236.8c-10.7-7.8-13.1-22.8-5.3-33.5z"/></svg>
              <span>{{ col.kidsLabel or col.kids_label or "Echo Kids verfügbar" }}</span>
            </span>
            {% endif %}
          </div>
          {% if col.details %}
          <span class="dropdown-card__column-details">{{ col.details }}</span>
          {% endif %}
          {% if col.url %}
          <a class="dropdown-card__column-link" href="{{ col.url }}" rel="noopener noreferrer">
            {{ col.actionLabel or col.action_label or "Standort &amp; Infos &rarr;" | safe }}
          </a>
          {% endif %}
        </li>
        {% endfor %}
      </ul>
      {% else %}
      <ul class="dropdown-card__times-list" role="list">
        {% for timeItem in itemsList %}
        <li class="dropdown-card__time-item"{% if timeItem.showOn or timeItem.show_on %} data-show-on="{{ (timeItem.showOn or timeItem.show_on) | join(',') }}"{% endif %}{% if timeItem.displayInDefault !== undefined %} data-display-in-default="{{ timeItem.displayInDefault }}"{% elif timeItem.display_in_default !== undefined %} data-display-in-default="{{ timeItem.display_in_default }}"{% endif %}>
          <div class="dropdown-card__time-info">
            <strong class="dropdown-card__time-title">{{ timeItem.title }}</strong>
            {% if timeItem.location %}
            <span class="dropdown-card__time-location">{{ timeItem.location }}</span>
            {% endif %}
          </div>
          <div class="dropdown-card__time-badges">
            <span class="dropdown-card__time-badge">{{ timeItem.time }}</span>
            {% if timeItem.hasKids or timeItem.has_kids or timeItem.kids %}
            <span class="dropdown-card__kids-badge" aria-label="{{ timeItem.kidsLabel or timeItem.kids_label or 'Echo Kids verfügbar' }}">
              <svg class="fa-svg fa-child" viewBox="0 0 384 512" fill="currentColor" width="12" height="12" aria-hidden="true"><path d="M192 0c44.2 0 80 35.8 80 80s-35.8 80-80 80-80-35.8-80-80 35.8-80 80-80zM57.7 203.3c7.8-10.7 22.8-13.1 33.5-5.3L192 271l100.8-73c10.7-7.8 25.7-5.4 33.5 5.3s5.4 25.7-5.3 33.5L216 312v152c0 13.3-10.7 24-24 24s-24-10.7-24-24V312L63 236.8c-10.7-7.8-13.1-22.8-5.3-33.5z"/></svg>
              <span>{{ timeItem.kidsLabel or timeItem.kids_label or "Echo Kids verfügbar" }}</span>
            </span>
            {% endif %}
          </div>
        </li>
        {% endfor %}
      </ul>
      {% endif %}
    {% endif %}

    {% if item.url %}
    <div class="dropdown-card__footer">
      <a class="dropdown-card__action-link" href="{{ item.url }}" rel="noopener noreferrer">
        {{ item.actionLabel or item.action_label or "Alle Standorte &amp; Livestream &rarr;" | safe }}
      </a>
    </div>
    {% endif %}
  </div>
</details>
