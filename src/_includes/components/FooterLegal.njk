      <svg class="fa-svg fa-instagram" viewBox="0 0 448 512" fill="currentColor" width="20" height="20" aria-hidden="true">
        <path d="M224.1 141c-63.6 0-114.9 51.3-114.9 114.9s51.3 114.9 114.9 114.9S339 319.5 339 255.9 287.7 141 224.1 141zm0 189.6c-41.1 0-74.7-33.5-74.7-74.7s33.5-74.7 74.7-74.7 74.7 33.5 74.7 74.7-33.6 74.7-74.7 74.7zm146.4-194.3c0 14.9-12 26.8-26.8 26.8-14.9 0-26.8-12-26.8-26.8s12-26.8 26.8-26.8 26.8 12 26.8 26.8zm76.1 27.2c-1.7-35.9-9.9-67.7-36.2-93.9-26.2-26.2-58-34.4-93.9-36.2-37-2.1-147.9-2.1-184.9 0-35.8 1.7-67.6 9.9-93.9 36.1s-34.4 58-36.2 93.9c-2.1 37-2.1 147.9 0 184.9 1.7 35.9 9.9 67.7 36.2 93.9s58 34.4 93.9 36.2c37 2.1 147.9 2.1 184.9 0 35.9-1.7 67.7-9.9 93.9-36.2 26.2-26.2 34.4-58 36.2-93.9 2.1-37 2.1-147.8 0-184.8zM398.8 388c-7.8 19.6-22.9 34.7-42.6 42.6-29.5 11.7-99.5 9-132.1 9s-102.7 2.6-132.1-9c-19.6-7.8-34.7-22.9-42.6-42.6-11.7-29.5-9-99.5-9-132.1s-2.6-102.7 9-132.1c7.8-19.6 22.9-34.7 42.6-42.6 29.5-11.7 99.5-9 132.1-9s102.7-2.6 132.1 9c19.6 7.8 34.7 22.9 42.6 42.6 11.7 29.5 9 99.5 9 132.1s2.7 102.7-9 132.1z"/>
      </svg>
      {% elif social.platform == "website" %}
      <svg class="fa-svg fa-echo-logo" viewBox="0 0 100 100" fill="currentColor" width="20" height="20" aria-hidden="true">
        <path d="M69.244,48.67c0,-3.456 1.935,-6.46 4.757,-7.944l8.768,15.49c-1.367,0.905 -2.999,1.43 -4.739,1.43c-4.845,0 -8.768,-4.017 -8.768,-8.957l-0.018,-0.018Z"/>
        <path d="M66.44,27.389l3.461,6.116c-5.254,2.932 -8.839,8.632 -8.839,15.164c0,9.536 7.579,17.281 16.932,17.281c3.23,0 6.265,-0.923 8.839,-2.533l3.461,6.116c-3.585,2.208 -7.792,3.474 -12.3,3.474c-13.169,0 -23.872,-10.894 -23.872,-24.339c0,-9.156 4.97,-17.137 12.3,-21.281l0.018,-0Z"/>
        <path d="M87.933,92.57l-75.857,0c-6.869,0 -11.146,-7.582 -7.721,-13.626l37.928,-66.972c3.443,-6.062 12.016,-6.062 15.441,-0l4.721,8.342c-9.726,5.555 -16.311,16.178 -16.311,28.374c0,17.951 14.27,32.518 31.876,32.518c5.963,0 11.536,-1.665 16.311,-4.56l1.313,2.334c3.443,6.062 -0.852,13.626 -7.721,13.626l0.018,-0.036Z"/>
      </svg>
      {% elif social.platform == "facebook" %}
      <svg class="fa-svg fa-facebook" viewBox="0 0 512 512" fill="currentColor" width="20" height="20" aria-hidden="true">
        <path d="M504 256C504 119 393 8 256 8S8 119 8 256c0 123.78 90.69 226.38 209.25 245V327.69h-63V256h63v-54.64c0-62.15 37-96.48 93.67-96.48 27.14 0 55.52 4.84 55.52 4.84v61h-31.28c-30.8 0-40.41 19.12-40.41 38.73V256h68.78l-11 71.69h-57.78V501C413.31 482.38 504 379.78 504 256z"/>
      </svg>
      {% elif social.platform == "tiktok" %}
      <svg class="fa-svg fa-tiktok" viewBox="0 0 448 512" fill="currentColor" width="20" height="20" aria-hidden="true">
        <path d="M448,209.91a210.06,210.06,0,0,1-122.77-39.25V349.38A162.55,162.55,0,1,1,185,188.31V278.2a74.62,74.62,0,1,0,52.23,71.18V0l88,0a121.18,121.18,0,0,0,1.86,22.17h0A122.18,122.18,0,0,0,381,102.39a121.43,121.43,0,0,0,67,20.14Z"/>
      </svg>
      {% elif social.platform == "linkedin" %}
      <svg class="fa-svg fa-linkedin" viewBox="0 0 448 512" fill="currentColor" width="20" height="20" aria-hidden="true">
        <path d="M100.28 448H7.4V148.9h92.88zM53.79 108.1C24.09 108.1 0 83.5 0 53.8a53.79 53.79 0 0 1 107.58 0c0 29.7-24.1 54.3-53.79 54.3zM447.9 448h-92.68V302.4c0-34.7-.7-79.2-48.29-79.2-48.29 0-55.69 37.7-55.69 76.7V448h-92.78V148.9h89.08v40.8h1.3c12.4-23.5 42.69-48.3 87.88-48.3 94 0 111.3 61.9 111.3 142.3V448z"/>
      </svg>
      {% else %}
      <svg class="fa-svg fa-link" viewBox="0 0 512 512" fill="currentColor" width="20" height="20" aria-hidden="true">
        <path d="M326.612 185.391c59.977 59.978 59.977 157.26 0 217.238l-87.045 87.045c-59.977 59.977-157.259 59.977-217.238 0-59.977-59.978-59.977-157.26 0-217.238l54.403-54.403c4.686-4.686 12.284-4.686 16.971 0l22.627 22.627c4.686 4.686 4.686 12.284 0 16.971l-54.403 54.403c-37.485 37.485-37.485 98.257 0 135.743 37.486 37.486 98.258 37.486 135.743 0l87.045-87.045c37.486-37.485 37.486-98.257 0-135.743-4.686-4.686-4.686-12.284 0-16.971l22.627-22.627c4.686-4.686 12.284-4.686 16.971 0l7.299 7.299zm162.776-162.776c-59.977-59.977-157.259-59.977-217.238 0l-87.045 87.045c-59.977 59.977-59.977 157.26 0 217.238l7.299 7.299c4.686 4.686 12.284 4.686 16.971 0l22.627-22.627c4.686-4.686 4.686-12.284 0-16.971l-7.299-7.299c-37.486-37.486-37.486-98.258 0-135.743l87.045-87.045c37.486-37.485 98.258-37.485 135.743 0 37.486 37.486 37.486 98.258 0 135.743l-54.403 54.403c-4.686 4.686-4.686 12.284 0 16.971l22.627 22.627c4.686 4.686 12.284 4.686 16.971 0l54.403-54.403c59.977-59.978 59.977-157.26 0-217.238z"/>
      </svg>
      {% endif %}
    </a>
    {% endif %}
    {% endfor %}
  </nav>
  {% endif %}

  <div class="footer-legal__address">
    <p>
      {{ orgName }}<br>
      {{ streetVal }}<br>
      {{ cityVal }}<br>
      <a href="mailto:{{ emailVal }}" target="_blank" rel="noopener">{{ emailVal }}</a>
    </p>
  </div>

  <nav class="footer-legal__nav" aria-label="Rechtliche Hinweise">
    <a class="footer-legal__link" href="{{ impUrl }}">Impressum</a>
    <a class="footer-legal__link" href="{{ dsUrl }}">Datenschutz</a>
  </nav>
  <div class="footer-legal__copyright">
    &copy; {{ copyYear }} {{ orgName }}. Alle Rechte vorbehalten.
  </div>
</footer>
