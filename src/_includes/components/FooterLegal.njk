        <path d="M248 8C111.1 8 0 119.1 0 256s111.1 248 248 248 248-111.1 248-248S384.9 8 248 8zm100.7 364.9c-4.2 0-6.8-1.3-10.7-3.6-62.4-37.6-135-39.2-206.7-24.5-3.9 1-9 2.6-11.9 2.6-9.7 0-15.8-7.7-15.8-15.8 0-10.3 6.1-15.2 13.6-16.8 81.9-18.1 165.6-16.5 237 26.2 6.1 3.9 9.7 7.4 9.7 16.5s-7.1 15.4-15.2 15.4zm26.9-65.6c-5.2 0-8.7-2.3-12.3-4.2-62.5-37-155.7-51.9-238.6-29.4-4.8 1.3-7.4 2.6-11.9 2.6-10.7 0-19.4-8.7-19.4-19.4s5.2-17.8 15.5-20.7c90.5-25.6 195.9-10.7 269.8 34.6 6.1 3.9 9.4 8.4 9.4 16.8 0 10.7-8.7 19.7-19.5 19.7zm-2.7-67.9c-5.2 0-9.4-1.6-13.6-3.9-74.7-44.3-199.1-49.8-271.6-27.8-5.8 1.6-9.7 3.2-15.2 3.2-12.3 0-22.3-9.7-22.3-22.3s7.4-19.4 17.5-22.6c84.1-25.6 220.8-19.7 308.2 32.3 7.8 4.9 11.3 9.7 11.3 20.4 0 12.3-9.7 22.3-22.3 22.3z"/>
      </svg>
      {% elif social.platform == "email" %}
      <svg class="fa-svg fa-envelope" viewBox="0 0 512 512" fill="currentColor" width="20" height="20" aria-hidden="true">
        <path d="M48 64C21.5 64 0 85.5 0 112c0 15.1 7.1 29.3 19.2 38.4L236.8 313.6c11.4 8.5 27 8.5 38.4 0L492.8 150.4c12.1-9.1 19.2-23.3 19.2-38.4c0-26.5-21.5-48-48-48H48zM0 176V384c0 35.3 28.7 64 64 64H448c35.3 0 64-28.7 64-64V176L294.4 339.2c-22.8 17.1-54 17.1-76.8 0L0 176z"/>
