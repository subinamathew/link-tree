{
  "name": "link-tree",
  "version": "1.0.0",
  "description": "A privacy-first, static link-in-bio site",
  "type": "module",
  "scripts": {
    "validate": "node scripts/validate-content.mjs",
    "build:sass": "sass src/styles/main.scss _site/css/main.css --style=compressed --no-source-map",
    "build:eleventy": "eleventy",
    "build": "npm run validate && npm run build:sass && npm run build:eleventy && node scripts/verify-build.mjs",
    "dev:sass": "sass src/styles/main.scss _site/css/main.css --watch --style=expanded",
    "dev:eleventy": "eleventy --serve",
    "dev": "npm run build:sass && eleventy --serve",
    "storyblok:push": "storyblok push-components storyblok/components.json",
    "storyblok:pull": "storyblok pull-components"
  },
  "dependencies": {
    "storyblok-js-client": "^6.9.0"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "nunjucks": "^3.2.4",
    "sass": "^1.83.4",
    "storyblok": "^3.36.0",
    "vite": "^6.0.7"
  }
}
